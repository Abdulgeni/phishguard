# Copy to .env. No secrets live here; every value is a safe default.
# Rate-limit variables are added in Step 13.

# dev | test | prod
# WHOIS_FAKE_DELAY_SECONDS is only honored when APP_ENV=test.
APP_ENV=dev

LOG_LEVEL=INFO

# Model
MODEL_PATH=artifacts/model.joblib
ENABLE_EXPLANATIONS=false

# Request limits and budget
MAX_URL_LENGTH=2048
REQUEST_BUDGET_SECONDS=3
EMAIL_REQUEST_BUDGET_SECONDS=10
EMAIL_MAX_BODY_BYTES=102400
EMAIL_MAX_URLS=20

# WHOIS
WHOIS_DISABLED=false
WHOIS_TIMEOUT_SECONDS=2
WHOIS_FAKE_DELAY_SECONDS=0

# Rate limit (per client IP, per process)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=0.5

# Training / evaluation (no default: training fails loudly if unset)
DATASET_PATH=
EVAL_DATASET_PATH=
MIN_F1=0.90
